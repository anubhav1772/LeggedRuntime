<mujoco model="g1_white_scene">
    <include file="g1.xml"/>

    <visual>
        <headlight diffuse="0.5 0.5 0.5"
            ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>

        <rgba haze="0.98 0.98 0.98 1"/>
        <global azimuth="140" elevation="-20"/>
        <map fogstart="8" fogend="30" zfar="100"/>
        <quality shadowsize="4096"/>
    </visual>

    <asset>
        <texture type="skybox" builtin="gradient"
            rgb1="1 1 1" rgb2="0.98 0.98 0.98"
            width="512" height="3072"/>

        <texture type="2d" name="groundplane" builtin="checker"
            mark="edge" rgb1="0.90 0.90 0.90" rgb2="0.90 0.90 0.90"
            markrgb="0.45 0.45 0.45" width="128" height="128"/>

        <material name="groundplane" texture="groundplane"
            texuniform="true" texrepeat="5 5"
            reflectance="0" specular="0" shininess="0"/>
    </asset>

    <worldbody>
        <light pos="0 0 5" dir="0 0 -1" directional="true"
            diffuse="0.6 0.6 0.6" castshadow="true"/>

        <geom name="floor" type="plane" size="0 0 0.05"
            material="groundplane"/>
    </worldbody>
</mujoco>
